{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSomenteAPastaRelatorios",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::NOME-DO-BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["relatorios/*"]
        }
      }
    },
    {
      "Sid": "LerObjetosDaPastaRelatorios",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::NOME-DO-BUCKET/relatorios/*"
    },
    {
      "Sid": "NegarAcessoSemTLS",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::NOME-DO-BUCKET",
        "arn:aws:s3:::NOME-DO-BUCKET/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
